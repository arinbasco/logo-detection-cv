# Plantilla de variables de entorno. Copia los nombres a tu .env y pon allí los valores.
# Nunca escribas valores en este archivo.

# Descarga del dataset de Roboflow
ROBOFLOW_API_KEY=

# API del modelo en local: clave con la que arranca. Debe tener el mismo valor que MODEL_API_KEY
API_KEY=

# Backend
MODEL_API_URL=
MODEL_API_KEY=
DATABASE_URL=
FRONT_ORIGIN=
# 1 muestra /docs, 0 o vacía la oculta
MOSTRAR_DOCS=
# informe en la nube, informe,en_vivo en local
MODOS=
# Opcional: peticiones por minuto e IP en el modo en vivo. Si se deja vacía, 30
LIMITE_EN_VIVO_POR_MINUTO=

# Solo en Render: versión de Python del servicio
PYTHON_VERSION=
